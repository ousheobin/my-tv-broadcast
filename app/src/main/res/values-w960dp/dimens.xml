<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Every token is 0.75 x the 1280dp design canvas, so the physical size stays identical on a 960dp-wide box. Edit values/dimens.xml and regenerate; do not hand-edit this tier. -->
    <!-- ==================== -->
    <!-- Android TV Layout System -->
    <!-- Based on TV design guidelines: 48dp margins, proper spacing -->
    <!-- ==================== -->

    <!-- Screen Safe Margins (TV: avoid content too close to edge) -->
    <dimen name="screen_margin_horizontal">36dp</dimen>
    <dimen name="screen_margin_vertical">24dp</dimen>
    <dimen name="screen_edge_padding">36dp</dimen>

    <!-- Sidebar/Lane Dimensions -->
    <dimen name="sidebar_width">180dp</dimen>
    <dimen name="sidebar_padding">18dp</dimen>
    <dimen name="fastlane_width">180dp</dimen>
    <dimen name="vertical_tabs_width">150dp</dimen>

    <!-- Section Spacing -->
    <dimen name="section_spacing">24dp</dimen>
    <dimen name="row_spacing">18dp</dimen>
    <dimen name="card_spacing">8dp</dimen>
    <!-- 卡片横向间距：首卡 marginStart=0 才能与行标题同一条内容线，间距全部由 marginEnd 承担 -->
    <dimen name="ui_card_gap">15dp</dimen>

    <!-- Card Dimensions -->
    <dimen name="channel_card_width">240dp</dimen>
    <dimen name="channel_card_height">105dp</dimen>
    <dimen name="channel_card_corner_radius">9dp</dimen>
    <dimen name="channel_card_elevation">6dp</dimen>
    <dimen name="channel_card_margin">9dp</dimen>
    <dimen name="channel_logo_size">150dp</dimen>
    <dimen name="gradient_overlay_height">75dp</dimen>

    <!-- Grid Settings -->
    <dimen name="grid_item_width">210dp</dimen>
    <dimen name="grid_item_height">135dp</dimen>
    <dimen name="grid_spacing">15dp</dimen>
    <dimen name="grid_padding">18dp</dimen>

    <!-- Settings Card -->
    <dimen name="settings_card_width">180dp</dimen>
    <dimen name="settings_card_height">120dp</dimen>
    <dimen name="settings_icon_size">48dp</dimen>

    <!-- Header/Divider -->
    <dimen name="header_height">60dp</dimen>
    <dimen name="header_padding">18dp</dimen>
    <dimen name="divider_height">1dp</dimen>
    <dimen name="source_bar_height">48dp</dimen>
    <dimen name="category_tabs_height">42dp</dimen>

    <!-- Text Sizes (TV: larger for distance viewing) -->
    <dimen name="text_title_large">24sp</dimen>
    <dimen name="text_title_medium">21sp</dimen>
    <dimen name="text_title_small">18sp</dimen>
    <dimen name="text_body_large">16.5sp</dimen>
    <dimen name="text_body_medium">15sp</dimen>
    <dimen name="text_body_small">13.5sp</dimen>
    <dimen name="text_label">12sp</dimen>

    <!-- Touch Target (minimum 48dp for TV D-pad navigation) -->
    <dimen name="touch_target_min">36dp</dimen>
    <dimen name="button_min_width">66dp</dimen>
    <dimen name="button_height">36dp</dimen>

    <!-- Focus/Padding -->
    <dimen name="focus_padding">6dp</dimen>
    <dimen name="content_padding">12dp</dimen>
    <dimen name="item_padding">9dp</dimen>

    <!-- Icon Sizes -->
    <dimen name="icon_small">18dp</dimen>
    <dimen name="icon_medium">24dp</dimen>
    <dimen name="icon_large">36dp</dimen>
    <dimen name="icon_xlarge">48dp</dimen>

    <!-- Play Icon -->
    <dimen name="play_icon_size">48dp</dimen>

    <!-- Focus Animation Scale - 符合 TV Design Guide 1.025x-1.1x 范围 -->
    <dimen name="card_focus_scale">1.05</dimen>

    <!-- ==================== -->
