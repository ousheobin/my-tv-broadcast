<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Every token is 1.5 x the 1280dp design canvas, so the physical size stays identical on a 1920dp-wide box. Edit values/dimens.xml and regenerate; do not hand-edit this tier. -->
    <!-- ==================== -->
    <!-- Android TV Layout System -->
    <!-- Based on TV design guidelines: 48dp margins, proper spacing -->
    <!-- ==================== -->

    <!-- Screen Safe Margins (TV: avoid content too close to edge) -->
    <dimen name="screen_margin_horizontal">72dp</dimen>
    <dimen name="screen_margin_vertical">48dp</dimen>
    <dimen name="screen_edge_padding">72dp</dimen>

    <!-- Sidebar/Lane Dimensions -->
    <dimen name="sidebar_width">360dp</dimen>
    <dimen name="sidebar_padding">36dp</dimen>
    <dimen name="fastlane_width">360dp</dimen>
    <dimen name="vertical_tabs_width">300dp</dimen>

    <!-- Section Spacing -->
    <dimen name="section_spacing">48dp</dimen>
    <dimen name="row_spacing">36dp</dimen>
    <dimen name="card_spacing">15dp</dimen>
    <!-- 卡片横向间距：首卡 marginStart=0 才能与行标题同一条内容线，间距全部由 marginEnd 承担 -->
    <dimen name="ui_card_gap">30dp</dimen>

    <!-- Card Dimensions -->
    <dimen name="channel_card_width">480dp</dimen>
