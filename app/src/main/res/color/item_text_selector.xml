<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 焦点(白底反色)：深色文字 -->
    <item android:color="@color/ui_focus_ink" android:state_focused="true" />
    <!-- 当前选中(非焦点)：白色文字 -->
    <item android:color="@color/ui_text_primary" android:state_selected="true" />
    <!-- 默认：白色文字(设计稿胶囊文字为白，焦点时反色为墨) -->
    <item android:color="@color/ui_text_primary" />
</selector>
