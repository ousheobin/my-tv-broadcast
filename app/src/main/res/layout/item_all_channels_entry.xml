<?xml version="1.0" encoding="utf-8"?>
<!-- 「全部频道」入口卡片：与频道卡同尺寸同聚焦态，居中图标 + 文案 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="@dimen/channel_card_height"
    android:layout_margin="@dimen/card_spacing"
    android:layout_marginBottom="14dp"
    android:background="@drawable/bg_channel_card"
    android:clipToPadding="false"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:clickable="true">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center">

        <ImageView
            android:layout_width="@dimen/icon_xlarge"
            android:layout_height="@dimen/icon_xlarge"
            android:src="@drawable/ic_all_channels"
            android:contentDescription="@string/all_channels_desc" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/all_channels"
            android:textColor="@color/ui_text_primary"
            android:textSize="@dimen/channel_name_text_size"
            android:textStyle="bold"
            android:letterSpacing="0.01" />

    </LinearLayout>

</FrameLayout>
