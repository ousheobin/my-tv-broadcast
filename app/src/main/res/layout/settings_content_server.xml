<?xml version="1.0" encoding="utf-8"?>
<!-- HTTP 服务设置：对齐 Screen C 行卡/面板规范 -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:focusable="false"
    android:descendantFocusability="afterDescendants">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="HTTP 服务"
            android:textColor="@color/ui_text_primary"
            android:textSize="@dimen/ui_row_title_size"
            android:textStyle="bold"
            android:layout_marginBottom="4dp"
            android:focusable="false" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="开启后可通过手机浏览器管理信号源"
            android:textColor="@color/ui_text_secondary"
            android:textSize="@dimen/ui_row_sub_size"
            android:layout_marginBottom="@dimen/ui_settings_gap"
            android:focusable="false" />

        <!-- Server Toggle：940×72 rx16 行卡 -->
        <LinearLayout
            android:id="@+id/server_toggle_container"
            android:layout_width="match_parent"
            android:layout_height="@dimen/ui_settings_row_height"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="@dimen/ui_pill_padding_h"
            android:paddingEnd="@dimen/ui_pill_padding_h"
            android:background="@drawable/bg_settings_row"
            android:focusable="false"
            android:clickable="false">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="服务开关"
                android:textColor="@color/ui_text_primary"
                android:textSize="@dimen/ui_row_title_size"
                android:textStyle="bold"
                android:focusable="false" />

            <TextView
                android:id="@+id/server_status_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="已关闭"
                android:textColor="@color/ui_text_secondary"
                android:textSize="@dimen/ui_row_sub_size"
                android:layout_marginEnd="16dp"
                android:focusable="false" />

            <TextView
                android:id="@+id/toggle_button"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/ui_button_height"
                android:text="切换"
                android:textColor="@color/item_text_selector"
                android:textSize="@dimen/ui_pill_text_size"
                android:textStyle="bold"
                android:gravity="center"
                android:paddingStart="@dimen/ui_pill_padding_h"
                android:paddingEnd="@dimen/ui_pill_padding_h"
                android:background="@drawable/bg_settings_button"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:clickable="true" />

        </LinearLayout>

        <!-- Error Message -->
        <TextView
            android:id="@+id/error_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/ui_text_danger"
            android:textSize="@dimen/ui_row_sub_size"
            android:paddingTop="8dp"
            android:visibility="gone"
            android:focusable="false" />

        <!-- QR Code：940×280 rx16 大面板 -->
        <LinearLayout
            android:id="@+id/qr_code_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="@dimen/ui_settings_padding"
            android:layout_marginTop="@dimen/ui_settings_gap"
            android:background="@drawable/bg_settings_panel"
            android:visibility="gone"
            android:focusable="false">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="手机扫码访问"
                android:textColor="@color/ui_text_secondary"
                android:textSize="@dimen/ui_row_sub_size"
                android:layout_marginBottom="12dp"
                android:focusable="false" />

            <ImageView
                android:id="@+id/qr_code_image"
                android:layout_width="@dimen/ui_qr_size"
                android:layout_height="@dimen/ui_qr_size"
                android:background="@drawable/bg_qr_white"
                android:padding="8dp"
                android:contentDescription="QR code"
                android:focusable="false" />

            <TextView
                android:id="@+id/qr_code_url"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/ui_text_caption"
                android:textSize="13sp"
                android:layout_marginTop="12dp"
                android:focusable="false" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>
