<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="信号源管理"
        android:textColor="@color/ui_text_primary"
        android:textSize="@dimen/ui_row_title_size"
        android:textStyle="bold"
        android:layout_marginBottom="4dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="点击启用/禁用信号源"
        android:textColor="@color/ui_text_secondary"
        android:textSize="@dimen/ui_row_sub_size"
        android:layout_marginBottom="@dimen/ui_settings_gap" />

    <!-- 添加信号源表单 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="@dimen/ui_settings_gap"
        android:focusable="true"
        android:descendantFocusability="afterDescendants">

        <EditText
            android:id="@+id/input_source_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="信号源名称"
            android:textColor="@color/ui_text_primary"
            android:textColorHint="@color/ui_text_hint"
            android:textSize="@dimen/ui_row_sub_size"
            android:background="@drawable/bg_settings_input"
            android:padding="12dp"
            android:layout_marginEnd="8dp"
            android:inputType="text"
            android:maxLines="1"
            android:importantForAutofill="no" />

        <EditText
            android:id="@+id/input_source_url"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:hint="M3U URL"
            android:textColor="@color/ui_text_primary"
            android:textColorHint="@color/ui_text_hint"
            android:textSize="@dimen/ui_row_sub_size"
            android:background="@drawable/bg_settings_input"
            android:padding="12dp"
            android:layout_marginEnd="8dp"
            android:inputType="textUri"
            android:maxLines="1"
            android:importantForAutofill="no" />

        <TextView
            android:id="@+id/btn_add_source"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/ui_button_height"
            android:text="添加"
            android:textColor="@color/item_text_selector"
            android:textSize="@dimen/ui_pill_text_size"
            android:textStyle="bold"
            android:gravity="center"
            android:paddingStart="@dimen/ui_pill_padding_h"
            android:paddingEnd="@dimen/ui_pill_padding_h"
            android:background="@drawable/bg_settings_button"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:clickable="true" />

    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/sources_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:focusable="false"
        android:descendantFocusability="afterDescendants" />

</LinearLayout>
