<?xml version="1.0" encoding="utf-8"?>
<!-- Playback page, aligned to SVG spec Screen A (Now Playing) — docs/design-spec.md -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_playback_gradient">

    <androidx.media3.ui.PlayerView
        android:id="@+id/player_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:show_timeout="0"
        app:hide_on_touch="true"
        app:use_controller="false" />

    <!-- Top-left: 清晰度/状态 + 码率 Micro 小字（spec Screen A rel y≈27） -->
    <LinearLayout
        android:id="@+id/top_overlay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="@dimen/screen_edge_padding"
        android:background="@drawable/bg_top_scrim"
        android:layout_gravity="top">

        <TextView
            android:id="@+id/playback_info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/ui_text_hint"
            android:textSize="@dimen/ui_micro_text_size"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/network_speed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:textColor="@color/ui_text_hint"
            android:textSize="@dimen/ui_micro_text_size"
            android:maxLines="1"
            android:visibility="gone" />

    </LinearLayout>

    <!-- Center: 88dp circle (#FFF @ 10% + ring) with loading spinner -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center">

        <FrameLayout
            android:id="@+id/loading_container"
            android:layout_width="@dimen/ui_play_button_size"
            android:layout_height="@dimen/ui_play_button_size"
            android:background="@drawable/bg_circle_button"
            android:visibility="gone">

            <ProgressBar
                android:id="@+id/loading_indicator"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="center"
                android:visibility="gone" />

        </FrameLayout>

        <TextView
            android:id="@+id/loading_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="正在加载…"
            android:textColor="@color/ui_text_secondary"
            android:textSize="@dimen/text_body_medium"
            android:visibility="gone" />

    </LinearLayout>

    <!-- Bottom: upward shadow strip + 140dp full-width panel bar (#05080D @ 85%) -->
    <LinearLayout
        android:id="@+id/bottom_overlay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical">

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/ui_bottom_shadow_height"
            android:background="@drawable/bg_bottom_shadow_up" />

        <!-- 频道名+副信息在底条左侧（spec：Display 白字 + #8A9BB0 副文）；进度条暂不放置 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/ui_bottom_bar_height"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@color/ui_panel"
            android:paddingStart="@dimen/screen_edge_padding"
            android:paddingEnd="@dimen/screen_edge_padding">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/channel_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/ui_text_primary"
                    android:textSize="@dimen/playback_title_text_size"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/channel_index"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/ui_text_secondary"
                    android:textSize="@dimen/ui_row_sub_size"
                    android:maxLines="1" />

                <!-- EPG 当前节目名（与频道序号占同一行位，无节目表数据时隐藏） -->
                <TextView
                    android:id="@+id/epg_current_program"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/ui_text_secondary"
                    android:textSize="@dimen/ui_row_sub_size"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:visibility="gone" />

            </LinearLayout>

            <!-- EPG 进度：起始时间 + 进度条 + 结束时间/下一节目（design.svg 底条右侧） -->
            <LinearLayout
                android:id="@+id/epg_progress_row"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/epg_start_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/ui_text_hint"
                    android:textSize="@dimen/ui_micro_text_size" />

                <LinearLayout
                    android:id="@+id/epg_progress_track"
                    android:layout_width="@dimen/ui_progress_width"
                    android:layout_height="@dimen/ui_progress_height"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="12dp"
                    android:orientation="horizontal"
                    android:background="@drawable/bg_progress_track">

                    <View
                        android:id="@+id/epg_progress_fill"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="0"
                        android:background="@drawable/bg_progress_fill" />

                    <View
                        android:id="@+id/epg_progress_spacer"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/epg_end_time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/ui_text_hint"
                        android:textSize="@dimen/ui_micro_text_size"
                        android:gravity="end" />

                    <TextView
                        android:id="@+id/epg_next_program"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="@color/ui_text_secondary"
                        android:textSize="@dimen/ui_micro_text_size"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:gravity="end"
                        android:visibility="gone" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

    <!-- Source switch panel (bottom, hidden by default) -->
    <LinearLayout
        android:id="@+id/source_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:background="@color/ui_panel"
        android:padding="20dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="信号源切换"
            android:textColor="@color/ui_text_primary"
            android:textSize="@dimen/ui_row_title_size"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/source_switch_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:clipToPadding="false"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:focusable="true"
            android:descendantFocusability="afterDescendants" />

    </LinearLayout>

</FrameLayout>
