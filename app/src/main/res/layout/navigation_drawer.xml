<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/navigation_drawer"
    android:layout_width="@dimen/sidebar_width"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:orientation="vertical">

    <!-- 品牌字标：定制字形矢量，左缘对齐导航文字、上部区域内垂直居中 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/ui_drawer_header_height"
        android:layout_marginTop="@dimen/ui_drawer_item_gap">

        <ImageView
            android:id="@+id/brand_wordmark"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/ui_brand_wordmark_height"
            android:layout_gravity="center_vertical|start"
            android:layout_marginStart="@dimen/ui_drawer_indent"
            android:adjustViewBounds="true"
            android:contentDescription="@string/brand_wordmark"
            android:focusable="false"
            android:src="@drawable/wordmark_mytv" />

    </FrameLayout>

    <!-- Category List with scroll -->
    <ScrollView
        android:id="@+id/category_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:focusable="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/category_list"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:descendantFocusability="afterDescendants"
                android:focusable="false"
                android:paddingStart="0dp" />

        </LinearLayout>

    </ScrollView>

    <!-- 底部功能区：hairline 与导航分隔，两端渐隐 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/ui_hairline"
        android:layout_marginStart="@dimen/ui_drawer_indent"
        android:layout_marginEnd="@dimen/ui_drawer_item_gap"
        android:layout_marginBottom="@dimen/ui_drawer_item_gap"
        android:background="@drawable/bg_hairline_h" />

    <!-- Settings entry: 与分类项同一行式语言 -->
    <LinearLayout
        android:id="@+id/btn_settings"
        android:layout_width="match_parent"
        android:layout_height="@dimen/ui_drawer_item_height"
        android:layout_marginEnd="0dp"
        android:layout_marginBottom="@dimen/screen_margin_vertical"
        android:background="@drawable/bg_drawer_item"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/ui_drawer_indent"
        android:paddingEnd="@dimen/ui_drawer_item_gap"
        android:focusable="true"
        android:focusableInTouchMode="true">

        <ImageView
            android:layout_width="@dimen/ui_drawer_icon_size"
            android:layout_height="@dimen/ui_drawer_icon_size"
            android:src="@drawable/ic_settings"
            android:contentDescription="设置"
            android:duplicateParentState="true"
            android:tint="@color/drawer_item_text"
            tools:ignore="UseAppTint" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/ui_icon_gap"
            android:duplicateParentState="true"
            android:text="设置"
            android:textColor="@color/drawer_item_text"
            android:textSize="@dimen/ui_drawer_item_text_size" />

    </LinearLayout>

</LinearLayout>
