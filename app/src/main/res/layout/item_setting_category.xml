<?xml version="1.0" encoding="utf-8"?>
<!-- 设置分类导航胶囊：220×52 rx12，焦点反色白底 -->
<TextView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/category_title"
    android:layout_width="match_parent"
    android:layout_height="@dimen/ui_pill_height"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_item_focus_capsule"
    android:gravity="center_vertical"
    android:paddingStart="@dimen/ui_pill_padding_h"
    android:paddingEnd="@dimen/ui_pill_padding_h"
    android:textColor="@color/item_text_selector"
    android:textSize="@dimen/ui_pill_text_size"
    android:textStyle="bold"
    android:maxLines="1"
    android:ellipsize="end"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:clickable="true"
    android:nextFocusRight="@id/content_frame" />
