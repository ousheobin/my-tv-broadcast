<?xml version="1.0" encoding="utf-8"?>
<!-- 信号源筛选胶囊 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="@dimen/ui_pill_height"
    android:layout_marginEnd="12dp"
    android:paddingStart="@dimen/ui_pill_padding_h"
    android:paddingEnd="@dimen/ui_pill_padding_h"
    android:focusable="true"
    android:clickable="true"
    android:background="@drawable/bg_item_focus_capsule">

    <TextView
        android:id="@+id/source_filter_name"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:gravity="center"
        android:duplicateParentState="true"
        android:textColor="@color/item_text_selector"
        android:textSize="@dimen/ui_pill_text_size"
        android:textStyle="bold"
        android:maxLines="1"
        android:ellipsize="end" />

</FrameLayout>
