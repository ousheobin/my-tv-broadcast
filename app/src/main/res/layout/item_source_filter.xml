<?xml version="1.0" encoding="utf-8"?>
<!-- 信号源筛选 tab：无底色文字 + 底部指示条（Sony 式极简） -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="@dimen/ui_tab_height"
    android:layout_marginEnd="@dimen/ui_source_tab_gap"
    android:paddingStart="@dimen/ui_source_tab_padding_h"
    android:paddingEnd="@dimen/ui_source_tab_padding_h"
    android:focusable="true"
    android:clickable="true"
    android:background="@drawable/bg_source_tab">

    <TextView
        android:id="@+id/source_filter_name"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:gravity="center"
        android:duplicateParentState="true"
        android:textColor="@color/source_tab_text"
        android:textSize="@dimen/ui_pill_text_size"
        android:textStyle="bold"
        android:maxLines="1"
        android:ellipsize="end" />

</FrameLayout>
