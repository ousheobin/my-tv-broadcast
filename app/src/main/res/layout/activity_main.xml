<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_page_gradient">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal">

        <!-- Navigation Drawer with MyTV title -->
        <include
            android:id="@+id/navigation_drawer"
            layout="@layout/navigation_drawer" />

        <!-- 侧栏与内容区 hairline 分隔：两端渐隐 -->
        <View
            android:layout_width="@dimen/ui_hairline"
            android:layout_height="match_parent"
            android:layout_marginTop="@dimen/ui_drawer_indent"
            android:layout_marginBottom="@dimen/ui_drawer_indent"
            android:background="@drawable/bg_hairline_v" />

        <!-- Main Content Area -->
        <FrameLayout
            android:id="@+id/main_browse_fragment"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />

    </LinearLayout>

    <!-- 冷启动落地页：字标逐笔描线生成后缓慢呼吸，下方一行说明当前在等什么，内容就绪才淡出。 -->
    <FrameLayout
        android:id="@+id/landing"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_page_gradient"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/landing_wordmark"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/ui_landing_wordmark_height"
                android:layout_gravity="center_horizontal"
                android:adjustViewBounds="true"
                android:contentDescription="@string/brand_wordmark"
                android:src="@drawable/wordmark_mytv_animated" />

            <TextView
                android:id="@+id/landing_caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/ui_landing_caption_gap"
                android:letterSpacing="0.08"
                android:textColor="@color/ui_text_secondary"
                android:textSize="@dimen/ui_landing_caption_size" />

        </LinearLayout>

    </FrameLayout>

</FrameLayout>
