<?xml version="1.0" encoding="utf-8"?>
<!-- 落地页字标描线：8 笔按书写顺序错峰 reveal，最后一笔在 1500ms 收尾 -->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:drawable="@drawable/wordmark_mytv">

    <target android:name="m_stem">
        <objectAnimator
            android:duration="170"
            android:propertyName="trimPathStart"
            android:startOffset="0"
            android:valueFrom="1"
            android:valueTo="0"
            android:valueType="floatType" />
    </target>
    <target android:name="m_arch_1">
        <objectAnimator
            android:duration="330"
            android:propertyName="trimPathStart"
            android:startOffset="150"
            android:valueFrom="1"
            android:valueTo="0"
            android:valueType="floatType" />
    </target>
    <target android:name="m_arch_2">
        <objectAnimator
            android:duration="330"
            android:propertyName="trimPathStart"
            android:startOffset="400"
            android:valueFrom="1"
            android:valueTo="0"
            android:valueType="floatType" />
    </target>
    <target android:name="y_left">
        <objectAnimator
            android:duration="200"
            android:propertyName="trimPathStart"
            android:startOffset="620"
            android:valueFrom="1"
            android:valueTo="0"
            android:valueType="floatType" />
    </target>
    <target android:name="y_right">
        <objectAnimator
            android:duration="260"
            android:propertyName="trimPathStart"
            android:startOffset="700"
            android:valueFrom="1"
            android:valueTo="0"
            android:valueType="floatType" />
    </target>
    <target android:name="t_stem">
        <objectAnimator
            android:duration="220"
            android:propertyName="trimPathStart"
            android:startOffset="900"
            android:valueFrom="1"
            android:valueTo="0"
            android:valueType="floatType" />
    </target>
    <target android:name="t_bar">
        <objectAnimator
            android:duration="160"
            android:propertyName="trimPathStart"
            android:startOffset="1060"
            android:valueFrom="1"
            android:valueTo="0"
            android:valueType="floatType" />
    </target>
    <target android:name="v">
        <objectAnimator
            android:duration="320"
            android:propertyName="trimPathStart"
            android:startOffset="1180"
            android:valueFrom="1"
            android:valueTo="0"
            android:valueType="floatType" />
    </target>

</animated-vector>
