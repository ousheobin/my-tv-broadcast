<?xml version="1.0" encoding="utf-8"?>
<!-- 侧栏导航项：默认/选中透明（选中靠左侧指示条），聚焦才浮出白底 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <!-- 用 layer-list 的 left/right 偏移做内缩；inset 会向 View 上报 padding，把整行内容推右 -->
        <layer-list>
            <item
                android:left="@dimen/ui_drawer_block_inset"
                android:right="@dimen/ui_drawer_block_inset">
                <shape android:shape="rectangle">
                    <solid android:color="@color/ui_focus_fill" />
                    <corners android:radius="@dimen/ui_pill_radius" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <corners android:radius="@dimen/ui_pill_radius" />
        </shape>
    </item>
</selector>
