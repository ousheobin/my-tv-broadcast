<?xml version="1.0" encoding="utf-8"?>
<!-- 加载指示底衬：弱化的玻璃圆底，避免抢占画面 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="#0DFFFFFF" />
            <stroke
                android:width="1dp"
                android:color="#33FFFFFF" />
        </shape>
    </item>
</layer-list>
