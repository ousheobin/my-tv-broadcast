<?xml version="1.0" encoding="utf-8"?>
<!-- 设置页输入框(rx12)：深色底 + 10% 白描边；聚焦描边提亮 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/ui_surface_card_active" />
            <stroke
                android:width="@dimen/ui_card_stroke_focus"
                android:color="@color/ui_border_focus" />
            <corners android:radius="@dimen/ui_search_radius" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/ui_surface_card" />
            <stroke
                android:width="@dimen/ui_card_stroke"
                android:color="@color/ui_border" />
            <corners android:radius="@dimen/ui_search_radius" />
        </shape>
    </item>
</selector>
